# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Concrete Maturity API"
APP_VERSION="0.1.0"
DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite path relative to project root (default is ./concrete_maturity.db)
DATABASE_URL="sqlite+aiosqlite:///./concrete_maturity.db"

# ─── Security ─────────────────────────────────────────────────────────────────
# API key required in X-API-Key header for webhook ingestion endpoint
WEBHOOK_API_KEY="change-me-super-secret-key"

# ─── ThingsBoard ──────────────────────────────────────────────────────────────
THINGSBOARD_HOST="mqtt.thingsboard.cloud"
THINGSBOARD_PORT=1883

# ─── Maturity Defaults ────────────────────────────────────────────────────────
DEFAULT_DATUM_TEMPERATURE=-10.0
DEFAULT_TARGET_MATURITY=500.0

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500"
